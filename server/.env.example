# Copy to .env and fill in the blanks.

PGHOST=localhost
PGPORT=5432
PGDATABASE=campusfind

# Superuser: used only by db:setup / db:test
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=

# Application roles (any strong random strings)
STUDENT_APP_PASSWORD=
ADMIN_APP_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=8h

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
